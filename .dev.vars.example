# Resend API key for contact form emails
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Destination email for enquiries
CONTACT_EMAIL=info@cambiapaisagem.pt

# From address for outgoing emails (must be a verified Resend domain)
FROM_EMAIL=CambiaPaisagem <hello@yourdomain.com>

# Cloudflare Turnstile secret key, used to verify form submissions server-side.
# For local dev, use Cloudflare's official "always passes" test key as-is:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
