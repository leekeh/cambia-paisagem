---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ToursFilter from "../../../components/ToursFilter.tsx";
import { getCollection } from "astro:content";
import { useTranslations, languages, t } from "../../../i18n/index";
import type { Lang } from "../../../i18n/index";
import { getImage } from "astro:assets";
import { buildItemListSchema } from "../../../lib/schemas";

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const tr = useTranslations(lang);

const allTours = await getCollection("tours");

// Pre-optimise images so we can pass URLs to the client-side component
const toursData = await Promise.all(
  allTours.map(async (tour) => {
    const img = await getImage({
      src: tour.data.image,
      width: 480,
      height: 360,
    });
    return {
      slug: tour.data.slug,
      title: t(tour.data.title, lang),
      price: tour.data.price,
      duration: tour.data.duration,
      imageUrl: img.src,
      href: `/${lang}/tours/${tour.data.slug}`,
      viewMoreLabel: tr.home.viewMore,
      fromLabel: tr.tours.from,
    };
  }),
);

// ── SEO ──────────────────────────────────────────────────────────────────────
const itemListSchema = buildItemListSchema({
  label: tr.tours.pageTitle,
  lang,
  tours: toursData,
  site: Astro.site,
});
---

<BaseLayout
  lang={lang}
  title={tr.tours.pageTitle}
  structuredData={itemListSchema}
>
  <section class="section">
    <div class="container">
      <h1 class="section-title" style="font-family: var(--font-serif);">
        {tr.tours.pageTitle}
      </h1>
      <p class="tours-page__conditions-note">
        <strong>{tr.tours.sharedConditionsTitle}:</strong>
        {` `}
        {tr.tours.sharedConditionsMinGuests}
        {` `}
        {tr.tours.sharedConditionsExclusions}
        {` `}
        {tr.tours.sharedConditionsTransfers}
        {` `}
        <a href={`/${lang}/#transfer`} class="tours-page__conditions-note-link"
          >{tr.tours.sharedConditionsTransfersLink}</a
        >
      </p>
      <ToursFilter
        client:load
        tours={toursData}
        lang={lang}
        translations={{
          sortLabel: tr.tours.sortLabel,
          sortPrice: tr.tours.sortPrice,
          sortDuration: tr.tours.sortDuration,
          filterDurationMax: tr.tours.filterDurationMax,
          filterDurationMin: tr.tours.filterDurationMin,
          noResults: tr.tours.noResults,
        }}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .tours-page__conditions-note {
    margin: 0 0 var(--space-6);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .tours-page__conditions-note-link {
    color: var(--color-primary);
    text-decoration: underline;
  }
</style>
