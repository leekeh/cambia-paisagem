---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BookingModal from "../../../components/BookingModal.tsx";
import ReviewCard from "../../../components/ReviewCard.astro";
import { getCollection } from "astro:content";
import { useTranslations, languages, t, tArr } from "../../../i18n/index";
import type { Lang } from "../../../i18n/index";
import { Image, getImage } from "astro:assets";
import { buildProductSchema } from "../../../lib/schemas";
import TourCarousel from "../../../components/Map";
import { formatDurationRange } from "../../../util";

export async function getStaticPaths() {
  const allTours = await getCollection("tours");
  const langs = Object.keys(languages) as Lang[];
  return langs.flatMap((lang) =>
    allTours.map((tour) => ({
      params: { lang, slug: tour.data.slug },
      props: { tour },
    })),
  );
}

const { lang, slug } = Astro.params as { lang: Lang; slug: string };
const { tour } = Astro.props;
const tr = useTranslations(lang);

const title = t(tour.data.title, lang);
const description = t(tour.data.description, lang);
const highlights = tArr(tour.data.highlights, lang);

// ── SEO ──────────────────────────────────────────────────────────
const ogTourImg = await getImage({
  src: tour.data.image,
  width: 1200,
  height: 630,
});
const ogImageUrl = Astro.site
  ? new URL(ogTourImg.src, Astro.site).href
  : ogTourImg.src;

const allReviews = await getCollection("reviews");
const tourReviews = allReviews.filter(
  (r) => r.data.tourSlug === tour.data.slug,
);

const productSchema = buildProductSchema({
  title,
  description,
  imageUrl: ogImageUrl,
  price: tour.data.price,
  slug: tour.data.slug,
  lang,
  reviews: tourReviews,
  site: Astro.site,
});

const carouselData = await Promise.all(
  tour.data.steps.map(async (step) => ({
    ...step,
    image: step.img ? await getImage({ src: step.img, width: 800 }) : null,
  })),
);
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  image={ogImageUrl}
  structuredData={productSchema}
>
  <section class="section">
    <div class="container" style="max-width: 860px;">
      <Image
        src={tour.data.image}
        alt={title}
        class="tour-detail__hero"
        width={860}
        height={480}
      />

      <h1 class="tour-detail__title">
        {title}
      </h1>

      <div class="tour-detail__meta">
        <div class="tour-detail__meta-item">
          <span class="tour-detail__meta-label">{tr.tours.duration}</span>
          <span class="tour-detail__meta-value"
            >{formatDurationRange(tour.data.duration, lang)}</span
          >
        </div>
        <div class="tour-detail__meta-item">
          <span class="tour-detail__meta-label">{tr.tours.price}</span>
          <span class="tour-detail__meta-value"
            >{tr.tours.from} €{tour.data.price}</span
          >
        </div>
      </div>

      <p class="tour-detail__description">
        {description}
      </p>

      <div class="tour-detail__highlights">
        <h2 class="tour-detail__highlights-title">
          {tr.tours.highlights}
        </h2>
        <ul>
          {highlights.map((h) => <li>{h}</li>)}
        </ul>
      </div>

      <!-- tour steps -->

      <div class="tour-detail__highlights">
        <h2 class="tour-detail__highlights-title">
          {tr.tours.itinerary}
        </h2>
        <TourCarousel
          client:only="react"
          steps={carouselData}
          locale={lang}
          translations={{
            nextStep: tr.tours.nextStep,
            prevStep: tr.tours.prevStep,
            jumpStep: tr.tours.jumpStep,
          }}
        />
      </div>

      <div class="tour-detail__book">
        <BookingModal
          client:load
          tourTitle={title}
          tourSlug={slug}
          lang={lang}
          translations={{
            booking: tr.booking,
            tours: { book: tr.tours.book },
          }}
        />
      </div>

      <div
        class="tour-detail__conditions"
        aria-label={tr.tours.sharedConditionsTitle}
      >
        <h2 class="tour-detail__conditions-title">
          {tr.tours.sharedConditionsTitle}
        </h2>
        <p class="tour-detail__conditions-intro">
          {tr.tours.sharedConditionsIntro}
        </p>
        <ul class="tour-detail__conditions-list">
          <li>{tr.tours.sharedConditionsMinGuests}</li>
          <li>{tr.tours.sharedConditionsExclusions}</li>
          <li>{tr.tours.sharedConditionsGuide}</li>
          <li>
            {tr.tours.sharedConditionsTransfers}
            {` `}
            <a href={`/${lang}/#transfer`} class="tour-detail__conditions-link">
              {tr.tours.sharedConditionsTransfersLink}
            </a>
          </li>
        </ul>
      </div>

      {
        tourReviews.length > 0 && (
          <div class="tour-detail__reviews">
            <h2 class="tour-detail__reviews-title">{tr.reviews.pageTitle}</h2>
            <div class="tour-detail__reviews-grid">
              {tourReviews.map((review) => (
                <ReviewCard review={review} lang={lang} />
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .tour-detail__hero {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-8);
  }

  .tour-detail__title {
    font-family: var(--font-serif);
    font-size: var(--text-5xl);
    line-height: 1;
    font-weight: 400;
    margin-bottom: var(--space-6);
  }

  .tour-detail__meta {
    display: flex;
    gap: var(--space-8);
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }

  .tour-detail__meta-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .tour-detail__meta-label {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .tour-detail__meta-value {
    font-size: var(--text-xl);
    font-weight: 600;
    font-family: var(--font-sans);
    color: var(--color-text);
  }

  .tour-detail__description {
    font-size: var(--text-lg);
    line-height: 1.8;
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
  }

  .tour-detail__conditions {
    margin-top: var(--space-8);
    margin-bottom: var(--space-8);
    padding: var(--space-5);
    border-radius: var(--radius-md);
  }

  .tour-detail__conditions-title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }

  .tour-detail__conditions-intro {
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .tour-detail__conditions-list {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: var(--space-2);
  }

  .tour-detail__conditions-link {
    text-decoration: underline;
  }

  .tour-detail__highlights {
    margin-top: var(--space-8);
  }

  .tour-detail__highlights-title {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: 500;
    margin-bottom: var(--space-4);
  }

  .tour-detail__highlights ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .tour-detail__highlights li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-base);
  }

  .tour-detail__highlights li::before {
    content: "✓";
    color: var(--color-accent);
    font-weight: 700;
  }

  .tour-detail__book {
    margin-top: var(--space-12);
    display: flex;
    justify-content: center;
  }

  .tour-detail__reviews {
    margin-top: var(--space-16);
  }

  .tour-detail__reviews-title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 400;
    margin-bottom: var(--space-6);
  }

  .tour-detail__reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-6);
  }
</style>
