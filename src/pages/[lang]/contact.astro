---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactForm from "../../components/ContactForm.tsx";
import { getCollection } from "astro:content";
import { useTranslations, languages, t } from "../../i18n/index";
import type { Lang } from "../../i18n/index";
import { MailIcon, PhoneIcon, WhatsappIcon } from "../../icons";
import { emailAddress, phoneNumber } from "../../config";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const tr = useTranslations(lang);
const allTours = await getCollection("tours");

const tourOptions = allTours.map((tour) => ({
  value: tour.data.slug,
  label: t(tour.data.title, lang),
}));
---

<BaseLayout lang={lang} title={tr.contact.pageTitle}>
  <section class="section">
    <div class="container">
      <div class="contact-page__layout">
        <!-- Form column -->
        <div class="contact-page__info">
          <h1 style="font-family: var(--font-serif);">
            {tr.contact.pageTitle}
          </h1>
          <p>
            {tr.contact.content}
          </p>
          <ContactForm
            client:load
            tours={tourOptions}
            translations={tr.contact}
          />
        </div>

        <!-- Info column -->
        <div class="contact-page__info">
          <address class="contact-info-list">
            <a href={`tel:${phoneNumber}`} class="contact-info-list__item">
              <div class="contact-info-list__icon">
                <PhoneIcon />
              </div>

              <div>
                {phoneNumber}
              </div>
            </a>
            <a href={`mailto:${emailAddress}`} class="contact-info-list__item">
              <div class="contact-info-list__icon">
                <MailIcon />
              </div>

              <div>{emailAddress}</div>
            </a>

            <a
              href={`https://wa.me/${phoneNumber.replaceAll(" ", "").replaceAll("+", "")}`}
              class="contact-info-list__item"
            >
              <div class="contact-info-list__icon">
                <WhatsappIcon />
              </div>

              <div>{tr.contact.whatsapp}</div>
            </a>
          </address>
        </div>
      </div>
    </div>

    <style>
      .contact-page__layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-16);
        align-items: start;
      }

      .contact-page__info h1 {
        font-size: var(--text-3xl);
        font-weight: 400;
        margin-bottom: var(--space-6);
      }

      .contact-page__info p {
        color: var(--color-text-muted);
        margin-bottom: var(--space-8);
      }

      .contact-info-list {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
      }

      .contact-info-list__item {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        font-size: var(--text-base);
      }

      .contact-info-list__icon {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--color-surface);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: var(--text-lg);
      }

      @media (max-width: 768px) {
        .contact-page__layout {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </section>
</BaseLayout>
