---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactForm from "../../components/ContactForm.tsx";
import { getCollection } from "astro:content";
import { useTranslations, languages, t } from "../../i18n/index";
import type { Lang } from "../../i18n/index";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const tr = useTranslations(lang);
const allTours = await getCollection("tours");

const tourOptions = allTours.map((tour) => ({
  value: tour.data.slug,
  label: t(tour.data.title, lang),
}));
---

<BaseLayout lang={lang} title={tr.contact.pageTitle}>
  <section class="section">
    <div class="container">
      <div class="contact-page__layout">
        <!-- Info column -->
        <div class="contact-page__info">
          <h1>{tr.contact.pageTitle}</h1>
          <p>
            Portugal à sua medida. Entre em contacto connosco para planejar a
            sua experiência perfeita.
          </p>

          <div class="contact-info-list">
            <div class="contact-info-list__item">
              <div class="contact-info-list__icon">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.8a19.79 19.79 0 01-3.07-8.67A2 2 0 012.11 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 14.92z"
                  ></path>
                </svg>
              </div>
              <span>{tr.contact.phone_number}</span>
            </div>

            <div class="contact-info-list__item">
              <div class="contact-info-list__icon">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                  ></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
              <span>{tr.contact.email_address}</span>
            </div>
          </div>
        </div>

        <!-- Form column -->
        <div>
          <ContactForm
            client:load
            tours={tourOptions}
            translations={tr.contact}
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
