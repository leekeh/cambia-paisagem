---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TourCard from "../../components/TourCard.astro";
import ReviewCard from "../../components/ReviewCard.astro";
import { getCollection } from "astro:content";
import { useTranslations, languages } from "../../i18n/index";
import type { Lang } from "../../i18n/index";
import { Image } from "astro:assets";
import heroImg from "../../assets/images/hero-sintra.png";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const allTours = await getCollection("tours");
const allReviews = await getCollection("reviews");
// Show up to 3 featured reviews
const featuredReviews = allReviews.slice(0, 3);
// Show up to 3 featured tours
const featuredTours = allTours.slice(0, 3);
---

<BaseLayout lang={lang}>
  <!-- Hero -->
  <section class="hero">
    <Image
      src={heroImg}
      alt="Lisboa"
      class="hero__img"
      width={1200}
      height={720}
      loading="eager"
    />
    <div class="hero__overlay"></div>
    <div class="hero__content">
      <h1 class="hero__title">CambiaPaisagem</h1>
      <p class="hero__tagline">{t.hero.tagline}</p>
      <a href={`/${lang}/tours`} class="btn hero__cta">{t.hero.cta}</a>
    </div>
  </section>

  <!-- Featured Tours -->
  <section class="section" id="tours">
    <div class="container">
      <h2 class="section-title">{t.home.featuredTitle}</h2>
      <div class="tours-grid">
        {featuredTours.map((tour) => <TourCard tour={tour} lang={lang} />)}
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <section
    class="section"
    id="reviews"
    style="background: var(--color-surface);"
  >
    <div class="container">
      <h2 class="section-title">{t.home.reviewsTitle}</h2>
      <div class="reviews-grid">
        {
          featuredReviews.map((review) => (
            <ReviewCard review={review} lang={lang} />
          ))
        }
      </div>
      <div style="text-align: center; margin-top: 2rem;">
        <a href={`/${lang}/reviews`} class="btn btn-outline"
          >{t.home.allReviews}</a
        >
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="section" id="contact">
    <div class="container">
      <h2 class="section-title">{t.home.contactTitle}</h2>
      <div class="contact-info">
        <div class="contact-info__item">
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.8a19.79 19.79 0 01-3.07-8.67A2 2 0 012 0h3a2 2 0 012 1.72..."
            ></path>
            <path
              d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.8 19.79 19.79 0 01.4 2.12 2 2 0 012.11 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 14.92z"
            ></path>
          </svg>
          <a href={`tel:${t.contact.phone_number}`}>{t.contact.phone_number}</a>
        </div>
        <div class="contact-info__item">
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
            ></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          <a href={`mailto:${t.contact.email_address}`}
            >{t.contact.email_address}</a
          >
        </div>
        <a href={`/${lang}/contact`} class="btn btn-primary"
          >{t.home.sendMessage}</a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ─── Hero ─────────────────────────────────────────────────── */
  .hero {
    position: relative;
    height: calc(100svh - var(--nav-height));
    min-height: 480px;
    max-height: 720px;
    overflow: hidden;
  }

  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.15) 0%,
      rgba(0, 0, 0, 0.35) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-align: center;
    color: #fff;
    gap: var(--space-4);
  }

  .hero__title {
    font-family: var(--font-serif);
    font-size: var(--text-6xl);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.3);
  }

  .hero__tagline {
    font-size: var(--text-xl);
    font-weight: 300;
    letter-spacing: 0.02em;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.3);
  }

  .hero__cta {
    margin-top: var(--space-2);
    background: rgba(0, 0, 0, 0.65);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(4px);
    padding: 0.75rem 2.5rem;
    font-size: var(--text-base);
    letter-spacing: 0.04em;
  }
  .hero__cta:hover {
    background: rgba(0, 0, 0, 0.85);
    transform: translateY(-1px);
  }

  /* ─── Grids ─────────────────────────────────────────────────── */
  .tours-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-6);
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-6);
  }

  /* ─── Contact teaser ────────────────────────────────────────── */
  .contact-info {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .contact-info__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-base);
  }

  @media (max-width: 768px) {
    .hero__title {
      font-size: var(--text-4xl);
    }
  }
</style>
