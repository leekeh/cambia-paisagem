---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TourCard from "../../components/TourCard.astro";
import ReviewCard from "../../components/ReviewCard.astro";
import { getCollection } from "astro:content";
import { useTranslations, languages } from "../../i18n/index";
import type { Lang } from "../../i18n/index";
import { Image, getImage } from "astro:assets";
import heroImg from "../../assets/images/hero_sintra.png";
import { MailIcon, PhoneIcon } from "../../icons";
import { buildOrganizationSchema } from "../../lib/schemas";
import { emailAddress, phoneNumber } from "../../config";
import { WhatsappIcon } from "../../icons";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const allTours = await getCollection("tours");
const allReviews = await getCollection("reviews");
// Show up to 3 featured reviews
const featuredReviews = allReviews.slice(0, 3);
// Show up to 3 featured tours
const featuredTours = allTours.slice(0, 3);

// ── SEO ──────────────────────────────────────────────────────────
const ogHeroImg = await getImage({ src: heroImg, width: 1200, height: 630 });
const ogImageUrl = Astro.site
  ? new URL(ogHeroImg.src, Astro.site).href
  : ogHeroImg.src;

const organizationSchema = buildOrganizationSchema({
  lang,
  reviews: featuredReviews,
  site: Astro.site,
});
---

<BaseLayout lang={lang} image={ogImageUrl} structuredData={organizationSchema}>
  <!-- Hero -->
  <section class="hero">
    <Image
      src={heroImg}
      alt="Lisboa"
      class="hero__img"
      width={1200}
      height={720}
      loading="eager"
    />
    <div class="hero__content">
      <h1 class="hero__title">CambiaPaisagem</h1>
      <p class="hero__tagline">{t.hero.tagline}</p>
      <a href={`/${lang}/tours`} class="btn hero__cta">{t.hero.cta}</a>
    </div>
  </section>

  <!-- Featured Tours -->
  <section class="section" id="tours">
    <div class="container">
      <h2 class="section-title">{t.home.featuredTitle}</h2>
      <div class="tours-grid">
        {featuredTours.map((tour) => <TourCard tour={tour} lang={lang} />)}
      </div>
    </div>
    <div style="text-align: center; margin-top: 2rem;">
      <a href={`/${lang}/tours`} class="btn btn-outline">{t.home.allTours}</a>
    </div>
  </section>
  <!-- view all -->

  <!-- Reviews -->
  <section
    class="section"
    id="reviews"
    style="background: var(--color-surface);"
  >
    <div class="container">
      <h2 class="section-title">{t.home.reviewsTitle}</h2>
      <div class="reviews-grid">
        {
          featuredReviews.map((review) => (
            <ReviewCard review={review} lang={lang} />
          ))
        }
      </div>
      <div style="text-align: center; margin-top: 2rem;">
        <a href={`/${lang}/reviews`} class="btn btn-outline"
          >{t.home.allReviews}</a
        >
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="section" id="contact">
    <div class="container">
      <h2 class="section-title">{t.home.contactTitle}</h2>
      <address class="contact-info">
        <a href={`tel:${phoneNumber}`} class="contact-info__item">
          <PhoneIcon />
          {phoneNumber}
        </a>
        <a href={`mailto:${emailAddress}`} class="contact-info__item">
          <MailIcon />
          {emailAddress}
        </a>
        <a href={`/${lang}/contact`} class="contact-info__item"
          >{t.home.sendMessage}</a
        >
        <a
          href={`https://wa.me/${phoneNumber.replaceAll(" ", "").replaceAll("+", "")}`}
          class="btn btn-primary"
        >
          <WhatsappIcon />
          {t.contact.whatsapp}</a
        >
      </address>
    </div>
  </section>
</BaseLayout>

<style>
  /* ─── Hero ─────────────────────────────────────────────────── */
  .hero {
    position: relative;
    height: calc(100svh - var(--nav-height));
    min-height: 480px;
    max-height: 720px;
    overflow: hidden;
  }

  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__content {
    --overlay-color: rgba(0, 0, 0, 0.4);
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
    gap: var(--space-4);
    background-color: var(--overlay-color);
    /* add gradient at the bottom */
    padding: var(--space-6);
    margin-top: auto;
  }

  /* gradient on the top */
  .hero__content::after {
    --gradient-height: 50px;
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: var(--gradient-height);
    transform: translateY(calc(-1 * var(--gradient-height)));
    background: linear-gradient(to top, var(--overlay-color), transparent);
    z-index: -1;
  }

  .hero__title {
    font-family: var(--font-serif);
    font-size: var(--text-6xl);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-shadow: 0 2px 5px rgba(0, 0, 0, 0.3);
  }

  .hero__tagline {
    font-size: var(--text-xl);
    font-weight: 300;
    letter-spacing: 0.02em;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.3);
  }

  .hero__cta {
    margin-top: var(--space-2);
    background: rgba(0, 0, 0, 0.65);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(4px);
    padding: 0.75rem 2.5rem;
    font-size: var(--text-base);
    letter-spacing: 0.04em;
  }
  .hero__cta:hover {
    background: rgba(0, 0, 0, 0.85);
    transform: translateY(-1px);
  }

  /* ─── Grids ─────────────────────────────────────────────────── */
  .tours-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-6);
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-6);
  }

  /* ─── Contact teaser ────────────────────────────────────────── */
  .contact-info {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .contact-info__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-base);
  }

  @media (max-width: 768px) {
    .hero__title {
      font-size: var(--text-4xl);
    }
  }
</style>
