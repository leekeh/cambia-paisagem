---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TourCard from "../../components/TourCard.astro";
import ReviewCard from "../../components/ReviewCard.astro";
import { getCollection } from "astro:content";
import { useTranslations, languages } from "../../i18n/index";
import type { Lang } from "../../i18n/index";
import { Image, getImage } from "astro:assets";
import heroImg from "../../assets/images/hero_sintra.webp";
import { MailIcon, PhoneIcon } from "../../icons";
import { buildOrganizationSchema } from "../../lib/schemas";
import { emailAddress, phoneNumber } from "../../config";
import { WhatsappIcon } from "../../icons";
import TransferBookingModal from "../../components/TransferBookingModal";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const allTours = await getCollection("tours");
const allReviews = await getCollection("reviews");
// Show up to 3 featured reviews
const featuredReviews = allReviews.slice(0, 3);
// Show up to 3 featured tours
const featuredTours = allTours.slice(0, 3);

// ── SEO ──────────────────────────────────────────────────────────
const ogHeroImg = await getImage({ src: heroImg, width: 1200, height: 630 });
const ogImageUrl = Astro.site
  ? new URL(ogHeroImg.src, Astro.site).href
  : ogHeroImg.src;

const organizationSchema = buildOrganizationSchema({
  lang,
  reviews: featuredReviews,
  site: Astro.site,
});
---

<BaseLayout lang={lang} image={ogImageUrl} structuredData={organizationSchema}>
  <!-- Hero -->
  <section class="hero">
    <Image
      src={heroImg}
      alt="Lisboa"
      class="hero__img"
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__content">
      <h1 class="hero__title">CambiaPaisagem</h1>
      <p class="hero__tagline">{t.hero.tagline}</p>
      <a href={`/${lang}/tours`} class="btn hero__cta">{t.hero.cta}</a>
    </div>
  </section>

  <!-- Featured Tours -->
  <section class="section" id="tours">
    <div class="container">
      <h2 class="section-title">{t.home.featuredTitle}</h2>
      <div class="tours-grid">
        {featuredTours.map((tour) => <TourCard tour={tour} lang={lang} />)}
      </div>
    </div>
    <div style="text-align: center; margin-top: 2rem;">
      <a href={`/${lang}/tours`} class="btn btn-outline">{t.home.allTours}</a>
    </div>
  </section>
  <!-- view all -->

  <!-- Reviews -->
  <section
    class="section"
    id="reviews"
    style="background: var(--color-surface);"
  >
    <div class="container">
      <h2 class="section-title">{t.home.reviewsTitle}</h2>
      <div class="reviews-grid">
        {
          featuredReviews.map((review) => (
            <ReviewCard review={review} lang={lang} />
          ))
        }
      </div>
      <div style="text-align: center; margin-top: 2rem;">
        <a href={`/${lang}/reviews`} class="btn btn-outline"
          >{t.home.allReviews}</a
        >
      </div>
    </div>
  </section>

  <!-- Services: Transfers & Taxi -->
  <section class="section" id="transfer">
    <div class="container">
      <h2 class="section-title">{t.home.servicesTitle}</h2>
      <div class="services-grid">
        <!-- Private Taxi Card -->
        <div class="service-card">
          <h3 class="service-card__title">{t.home.privateTaxiTitle}</h3>
          <p class="service-card__description">
            {t.home.privateTaxiDescription}
          </p>
          <p class="service-card__note">{t.home.privateTaxiNote}</p>
          <div class="service-card__cta">
            <TransferBookingModal
              client:load
              lang={lang}
              ctaLabel={t.home.bookNow}
              transferType="private-taxi"
              modalTitle={t.transfer.privateTaxiModalTitle}
              pickupPlaceholder={t.transfer.privateTaxiPickupPlaceholder}
              dropoffPlaceholder={t.transfer.privateTaxiDropoffPlaceholder}
              translations={{ transfer: t.transfer }}
            />
            <a
              href={`https://wa.me/${phoneNumber.replaceAll(" ", "").replaceAll("+", "")}?text=${encodeURIComponent(t.transfer.privateTaxiWhatsapp)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-outline"
            >
              <WhatsappIcon />
              {t.home.messageNow}
            </a>
          </div>
        </div>

        <!-- Airport & Cruise Transfer Card -->
        <div class="service-card">
          <h3 class="service-card__title">{t.home.airportTransferTitle}</h3>
          <p class="service-card__description">
            {t.home.airportTransferDescription}
          </p>
          <p class="service-card__note">{t.home.airportTransferNote}</p>
          <div class="service-card__cta">
            <TransferBookingModal
              client:load
              lang={lang}
              ctaLabel={t.home.bookNow}
              transferType="airport-cruise-transfer"
              modalTitle={t.transfer.airportTransferModalTitle}
              pickupPlaceholder={t.transfer.airportTransferPickupPlaceholder}
              dropoffPlaceholder={t.transfer.airportTransferDropoffPlaceholder}
              translations={{ transfer: t.transfer }}
            />
            <a
              href={`https://wa.me/${phoneNumber.replaceAll(" ", "").replaceAll("+", "")}?text=${encodeURIComponent(t.transfer.airportTransferWhatsapp)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-outline"
            >
              <WhatsappIcon />
              {t.home.messageNow}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="section" id="contact">
    <div class="container">
      <h2 class="section-title">{t.home.contactTitle}</h2>
      <address class="contact-info">
        <a href={`tel:${phoneNumber}`} class="contact-info__item">
          <PhoneIcon />
          {phoneNumber}
        </a>
        <a href={`mailto:${emailAddress}`} class="contact-info__item">
          <MailIcon />
          {emailAddress}
        </a>
        <a href={`/${lang}/contact`} class="contact-info__item"
          >{t.home.sendMessage}</a
        >
        <a
          href={`https://wa.me/${phoneNumber.replaceAll(" ", "").replaceAll("+", "")}`}
          class="btn btn-primary"
        >
          <WhatsappIcon />
          {t.contact.whatsapp}</a
        >
      </address>
    </div>
  </section>
</BaseLayout>

<style>
  /* ─── Hero ─────────────────────────────────────────────────── */
  .hero {
    position: relative;
    height: calc(100svh - var(--nav-height));
    min-height: 480px;
    max-height: 720px;
    overflow: hidden;
  }

  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__content {
    --overlay-color: rgba(0, 0, 0, 0.4);
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
    gap: var(--space-4);
    background-color: var(--overlay-color);
    /* add gradient at the bottom */
    padding: var(--space-6);
    margin-top: auto;
  }

  /* gradient on the top */
  .hero__content::after {
    --gradient-height: 50px;
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: var(--gradient-height);
    transform: translateY(calc(-1 * var(--gradient-height)));
    background: linear-gradient(to top, var(--overlay-color), transparent);
    z-index: -1;
  }

  .hero__title {
    font-family: var(--font-serif);
    font-size: var(--text-6xl);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-shadow: 0 2px 5px rgba(0, 0, 0, 0.3);
  }

  .hero__tagline {
    font-size: var(--text-xl);
    font-weight: 300;
    letter-spacing: 0.02em;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.3);
  }

  .hero__cta {
    margin-top: var(--space-2);
    background: rgba(0, 0, 0, 0.65);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(4px);
    padding: 0.75rem 2.5rem;
    font-size: var(--text-base);
    letter-spacing: 0.04em;
  }
  .hero__cta:hover {
    background: rgba(0, 0, 0, 0.85);
    transform: translateY(-1px);
  }

  /* ─── Grids ─────────────────────────────────────────────────── */
  .tours-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-6);
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-6);
  }

  /* ─── Contact teaser ────────────────────────────────────────── */
  .contact-info {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .contact-info__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-base);
  }

  .transfer-box {
    display: grid;
    grid-template-columns: 2fr 1fr;
    align-items: center;
    gap: var(--space-8);
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(
        circle at 15% 15%,
        rgba(255, 255, 255, 0.8),
        transparent 45%
      ),
      linear-gradient(120deg, #ece4da, #f7f3ee 45%, #e3d8cb);
  }

  .transfer-box__title {
    margin-bottom: var(--space-3);
  }

  .transfer-box__description {
    max-width: 56ch;
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  .transfer-box__service-note {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .transfer-box__price {
    margin-top: var(--space-2);
    font-size: var(--text-lg);
    color: var(--color-accent);
  }

  .transfer-box__cta {
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  /* ─── Services Grid ────────────────────────────────────────── */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-8);
    margin-top: var(--space-8);
  }

  .service-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    transition: all 0.3s ease;
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .service-card__title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 400;
    color: var(--color-accent);
    margin: 0;
  }

  .service-card__description {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: 1.6;
    flex-grow: 1;
    margin: 0;
  }

  .service-card__note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-style: italic;
    margin: 0;
  }

  .service-card__cta {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .service-card__cta .btn {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex: 1;
    justify-content: center;
  }

  @media (max-width: 768px) {
    .hero__title {
      font-size: var(--text-4xl);
    }

    .transfer-box {
      grid-template-columns: 1fr;
      text-align: center;
      padding: var(--space-6);
    }

    .transfer-box__description {
      margin-inline: auto;
    }

    .transfer-box__cta {
      justify-content: center;
    }

    .services-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .service-card {
      padding: var(--space-6);
    }

    .service-card__title {
      font-size: var(--text-xl);
    }

    .service-card:hover {
      transform: none;
    }
  }
</style>
