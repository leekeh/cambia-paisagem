---
import "../styles/global.css";
import "../styles/leaflet.css";
import Nav from "../components/Nav.astro";
import SEO from "../components/SEO.astro";

import type { Lang } from "../i18n/index";
import { useTranslations } from "../i18n/index";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Fully-qualified URL for OG / Twitter card image */
  image?: string;
  /** Fully-qualified canonical URL; defaults to current page URL */
  canonical?: string;
  /** OG type, e.g. "website" | "article" — defaults to "website" */
  ogType?: string;
  /** One or more JSON-LD structured-data objects to inject */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { lang, title, description, image, canonical, ogType, structuredData } =
  Astro.props;
const t = useTranslations(lang);
const pageTitle = title ? `${title} — ${t.meta.siteName}` : t.meta.siteName;
const pageDesc = description ?? t.meta.description;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDesc} />
    <title>{pageTitle}</title>
    <SEO
      lang={lang}
      title={pageTitle}
      description={pageDesc}
      image={image}
      canonical={canonical}
      ogType={ogType}
      structuredData={structuredData}
    />
    <link rel="icon" type="image/jpeg" href="/favicon.jpeg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav lang={lang} />
    <main>
      <slot />
    </main>
    <footer class="footer">
      <div class="container">
        <p>
          &copy; {new Date().getFullYear()}
          {t.meta.siteName}. All rights reserved. Made with ❤️ by
          <a href="https://www.leekeh.com/" target="_blank">leekeh</a>.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-8);
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
