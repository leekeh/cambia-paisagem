---
import { Image } from "astro:assets";
import type { Lang } from "../i18n/index";
import { useTranslations, t } from "../i18n/index";
import type { CollectionEntry } from "astro:content";

interface Props {
  tour: CollectionEntry<"tours">;
  lang: Lang;
}

const { tour, lang } = Astro.props;
const tr = useTranslations(lang);
const { data } = tour;
---

<article class="tour-card">
  <a href={`/${lang}/tours/${data.slug}`}>
    <Image
      src={data.image}
      alt={t(data.title, lang)}
      class="tour-card__img"
      width={480}
      height={360}
    />
  </a>
  <div class="tour-card__body">
    <h3 class="tour-card__title">
      <a href={`/${lang}/tours/${data.slug}`}>{t(data.title, lang)}</a>
    </h3>
    <div class="tour-card__meta">
      <span class="tour-card__meta-item">
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path>
        </svg>
        {data.duration}
        {tr.tours.hours}
      </span>
      <span class="tour-card__price">
        {tr.tours.from}
        <strong>€{data.price}</strong>
      </span>
    </div>
    <div class="tour-card__footer">
      <a href={`/${lang}/tours/${data.slug}`} class="btn btn-outline">
        {tr.home.viewMore}
      </a>
    </div>
  </div>
</article>

<style>
  .tour-card {
    background: var(--color-bg-card);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition:
      box-shadow var(--transition-base),
      transform var(--transition-base);
    display: flex;
    flex-direction: column;
  }

  .tour-card:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-3px);
  }

  .tour-card__img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
  }

  .tour-card__body {
    padding: var(--space-4) var(--space-6) var(--space-6);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .tour-card__title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 400;
    margin-bottom: var(--space-3);
  }

  .tour-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .tour-card__meta-item {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .tour-card__price {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text);
  }

  .tour-card__price strong {
    font-size: var(--text-base);
  }

  .tour-card__footer {
    margin-top: auto;
    padding-top: var(--space-4);
    display: flex;
    justify-content: center;
  }
</style>
