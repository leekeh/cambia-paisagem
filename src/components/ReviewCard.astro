---
import type { Lang } from "../i18n/index";
import { t, useTranslations } from "../i18n/index";
import type { CollectionEntry } from "astro:content";

interface Props {
  review: CollectionEntry<"reviews">;
  lang: Lang;
}

const { review, lang } = Astro.props;

const tr = useTranslations(lang);

const { data } = review;
const formattedDate = data.date
  ? new Date(data.date).toLocaleDateString(
      lang === "pt" ? "pt-PT" : lang === "de" ? "de-DE" : "en-GB",
      { year: "numeric", month: "short", day: "numeric" },
    )
  : null;
---

<article class="review-card">
  <div
    class="review-card__stars"
    role="img"
    aria-label={tr.a11y.starRating.replaceAll(
      "%rating%",
      data.rating.toString(),
    )}
  >
    {
      Array.from({ length: 5 }).map((_, i) => (
        <span
          aria-hidden="true"
          style={
            i < data.rating
              ? "color: var(--color-star)"
              : "color: var(--color-border)"
          }
        >
          ★
        </span>
      ))
    }
  </div>
  <p class="review-card__summary">"{t(data.summary, lang)}"</p>
  <footer class="review-card__footer">
    <span class="review-card__author">{data.author}</span>
    {formattedDate && <span class="review-card__date">{formattedDate}</span>}
  </footer>
</article>

<style>
  .review-card {
    background: var(--color-bg-card);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    box-shadow: var(--shadow-card);
  }

  .review-card__stars {
    display: flex;
    gap: 2px;
    margin-bottom: var(--space-4);
    color: var(--color-star);
    font-size: var(--text-xl);
  }

  .review-card__summary {
    font-size: var(--text-base);
    font-style: italic;
    margin-bottom: var(--space-3);
    line-height: 1.5;
  }

  .review-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
  }

  .review-card__author {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .review-card__date {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    opacity: 0.7;
  }
</style>
