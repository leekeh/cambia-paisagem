---
import type { Lang } from "../i18n/index";
import { useTranslations, languages } from "../i18n/index";
import NavIsland from "./NavIsland.tsx";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;

function getLangUrl(targetLang: Lang): string {
  const withoutLang = currentPath.replace(new RegExp(`^/${lang}`), "") || "/";
  return `/${targetLang}${withoutLang}`;
}

const navLinks = [
  { href: `/${lang}/tours`, label: t.nav.tours },
  { href: `/${lang}/reviews`, label: t.nav.reviews },
  { href: `/${lang}/contact`, label: t.nav.contact },
];

const langOptions = Object.entries(languages).map(([code, info]) => ({
  code,
  label: info.label,
  flag: info.flag,
  href: getLangUrl(code as Lang),
}));
---

<nav class="nav">
  <div class="container nav__inner">
    <a href={`/${lang}/`} class="nav__brand">CambiaPaisagem</a>

    <ul class="nav__links" role="list">
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>

    <NavIsland
      client:load
      links={navLinks}
      langOptions={langOptions}
      currentLang={lang}
      langLabel={t.nav.language}
    />
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    height: var(--nav-height);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .nav__brand {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    list-style: none;
  }

  .nav__links a {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text);
    transition: color var(--transition-base);
  }
  .nav__links a:hover {
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .nav__links {
      display: none;
    }
  }
</style>
